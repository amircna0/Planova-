generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int             @id @default(autoincrement())
  email          String          @unique
  name           String?
  plan           String          @default("free")
  mode           String          @default("general")
  stripeCustomerId String?       @unique
  stripeSubscriptionId String?   @unique
  stripeSubscriptionStatus String?
  stripePriceId  String?
  billingCurrentPeriodEnd DateTime?
  onboardingCompleted Boolean    @default(false)
  onboardingCompletedAt DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  tasks          Task[]
  goals          Goal[]
  milestones     Milestone[]
  weeklyFocuses  WeeklyFocus[]
  focusBlocks    FocusBlock[]
  habits         Habit[]
  reports        Report[]
  notes          Note[]
  importantDates ImportantDate[]
  reflections    Reflection[]
  monthlyFocuses MonthlyFocus[]
  budgets        BudgetMonth[]
}

model Task {
  id            Int       @id @default(autoincrement())
  userId        Int
  title         String
  description   String?
  category      String?
  lifeArea      String?
  status        String    @default("todo")
  priority      Int?
  dueDate       DateTime?
  startTime     DateTime?
  endTime       DateTime?
  duration      Int?
  recurring     String?
  parentGoalId  Int?
  weeklyFocusId Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentGoal  Goal?        @relation("TaskToGoal", fields: [parentGoalId], references: [id])
  weeklyFocus WeeklyFocus? @relation(fields: [weeklyFocusId], references: [id], onDelete: SetNull)
  focusBlocks FocusBlock[]

  @@index([userId, dueDate])
  @@index([userId, status])
  @@index([userId, lifeArea])
  @@index([weeklyFocusId])
}

model Goal {
  id          Int      @id @default(autoincrement())
  userId      Int
  title       String
  description String?
  lifeArea    String?
  timeframe   String   @default("annual")
  status      String   @default("active")
  progress    Int      @default(0)
  parentId    Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subGoals      Goal[]        @relation("GoalHierarchy")
  parentGoal    Goal?         @relation("GoalHierarchy", fields: [parentId], references: [id])
  tasks         Task[]        @relation("TaskToGoal")
  milestones    Milestone[]
  weeklyFocuses WeeklyFocus[]

  @@index([userId, timeframe])
  @@index([userId, lifeArea])
  @@index([parentId])
}

model Milestone {
  id          Int       @id @default(autoincrement())
  userId      Int
  goalId      Int
  title       String
  description String?
  targetMonth String?
  dueDate     DateTime?
  status      String    @default("active")
  progress    Int       @default(0)
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal          Goal          @relation(fields: [goalId], references: [id], onDelete: Cascade)
  weeklyFocuses WeeklyFocus[]

  @@index([userId, goalId])
  @@index([userId, targetMonth])
  @@index([goalId, order])
}

model WeeklyFocus {
  id          Int      @id @default(autoincrement())
  userId      Int
  goalId      Int
  milestoneId Int?
  title       String
  weekStart   DateTime
  weekEnd     DateTime
  status      String   @default("active")
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal      Goal       @relation(fields: [goalId], references: [id], onDelete: Cascade)
  milestone Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  tasks     Task[]

  @@index([userId, weekStart])
  @@index([goalId, weekStart])
  @@index([milestoneId])
}

model FocusBlock {
  id        Int      @id @default(autoincrement())
  userId    Int
  taskId    Int?
  title     String?
  start     DateTime
  end       DateTime
  type      String   @default("focus")
  createdAt DateTime @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)
}

model Habit {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  frequency String
  category  String?
  lifeArea  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs HabitLog[]

  @@index([userId])
  @@index([userId, lifeArea])
}

model HabitLog {
  id        Int      @id @default(autoincrement())
  habitId   Int
  date      DateTime
  completed Boolean  @default(false)
  mood      Int?
  notes     String?
  createdAt DateTime @default(now())

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@index([date])
}

model Report {
  id              Int       @id @default(autoincrement())
  userId          Int
  type            String
  weekStart       DateTime?
  weekEnd         DateTime?
  tasksCompleted  Int       @default(0)
  tasksOverdue    Int       @default(0)
  bestDay         String?
  totalFocusHours Int       @default(0)
  moodAverage     Float?
  createdAt       DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, weekStart])
  @@index([userId, type])
}

model Note {
  id        Int      @id @default(autoincrement())
  userId    Int
  text      String
  month     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, month])
  @@index([userId, createdAt])
}

model ImportantDate {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  date      DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model Reflection {
  id        Int      @id @default(autoincrement())
  userId    Int
  date      DateTime
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

model MonthlyFocus {
  id        Int      @id @default(autoincrement())
  userId    Int
  month     String
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month])
}

model BudgetMonth {
  id        Int      @id @default(autoincrement())
  userId    Int
  month     String
  total     Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@unique([userId, month])
}

model Expense {
  id        Int      @id @default(autoincrement())
  budgetId  Int
  name      String
  amount    Float
  createdAt DateTime @default(now())

  budget BudgetMonth @relation(fields: [budgetId], references: [id], onDelete: Cascade)
}
